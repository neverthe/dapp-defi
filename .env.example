# 网络配置（测试网部署时：sepolia）
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_API_KEY

# 合约地址（部署后替换）
NEXT_PUBLIC_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_ROUTER_ADDRESS=0x...
NEXT_PUBLIC_TOKEN_A=0x...
NEXT_PUBLIC_TOKEN_B=0x...

# The Graph 子图 GraphQL 端点
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_SUBGRAPH_ID/defi-swap-sepolia/v0.0.1

# Pinata API Key（IPFS 上传用）
NEXT_PUBLIC_PINATA_JWT=YOUR_PINATA_JWT

# 仅用于 Hardhat 部署脚本，前端不需要（切勿提交真实私钥）
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY